OZON_TOKEN=replace-with-ozon-api-token
OZON_CLIENT_ID=replace-with-ozon-client-id
GOOGLE_CREDENTIALS_PATH=secrets/google-service-account.json
# Instead of a path, GOOGLE_CREDENTIALS_JSON may contain the service-account JSON.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"replace-me"}
GOOGLE_SPREADSHEET_ID=replace-with-google-spreadsheet-id
GOOGLE_WORKSHEET_NAME=Operations
# Optional historical override. Without it, yesterday and today are synchronized.
# OZON_DATE_FROM=2026-01-01
# OZON_DATE_TO=2026-01-31
