OZON_TOKEN=replace-with-ozon-api-token
OZON_CLIENT_ID=replace-with-ozon-client-id
# Recommended: keep the downloaded Google key in the gitignored secrets directory.
GOOGLE_CREDENTIALS_PATH=secrets/google-service-account.json
# Alternative for an external secret manager: remove the path above and provide the complete JSON.
# Never commit the real GOOGLE_CREDENTIALS_JSON value or keep both credential sources enabled.
# GOOGLE_CREDENTIALS_JSON=<complete-service-account-json-from-secret-manager>
GOOGLE_SPREADSHEET_ID=replace-with-google-spreadsheet-id
GOOGLE_WORKSHEET_ID=0
# Optional: pin the Docker image to a release tag or digest instead of latest.
# OZON_IMAGE=ghcr.io/sotchenkov/ozon_to_google_sheets:0.1.0
# Optional inclusive period (YYYY-MM-DD). Neither set: yesterday through today.
# FROM only: FROM through today. TO only: that day. Both: FROM through TO.
# OZON_DATE_FROM=2026-01-01
# OZON_DATE_TO=2026-01-31
